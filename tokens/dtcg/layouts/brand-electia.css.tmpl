  --purple-light: __RX_b0135__;   /* accent hover */
  --purple-on-dark: __RX_b0136__; /* sobre fundo claro, mantem identidade roxa — 6.86:1 sobre branco */

  /* ---- Text (light) ---- */
  --text-primary: __RX_b0137__;
  --text-secondary: __RX_b0138__;
  --text-muted: __RX_b0139__;   /* 5.19:1 sobre surface-2, 4.87:1 sobre a surface-3 do DS (era #6B7280: 4.34 / 4.07) */

  /* ---- Semantic (light) ---- */

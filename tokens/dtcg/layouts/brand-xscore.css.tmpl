  --text-eyebrow: __RX_b0056__;

  --weight-regular: __RX_b0057__;
  --weight-medium: __RX_b0058__;
  --weight-semibold: __RX_b0059__;
  --weight-bold: __RX_b0060__;

  --leading-tight: __RX_b0061__;

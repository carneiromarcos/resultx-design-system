  --warning: __RX_b0105__;   /* selo 5.28:1 (era 2.57:1) */
  --danger: __RX_b0106__;   /* selo 4.69:1 (era 3.60:1) */
  --on-danger: __RX_b0107__;
  --info: __RX_b0108__;   /* selo 5.60:1 (era 3.21:1) */


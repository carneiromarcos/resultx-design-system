  --tracking-eyebrow: __RX_b0066__;

  /* ---- Radius ---- */
  --radius-sm: __RX_b0067__;
  --radius-md: __RX_b0068__;
  --radius-lg: __RX_b0069__;
  --radius-xl: __RX_b0070__;
  --radius-full: __RX_b0071__;

  /* ---- Elevation ---- */
  --shadow-sm: __RX_b0072__;
  --shadow-md: __RX_b0073__;
  --shadow-lg: __RX_b0074__;
  --shadow-gold: __RX_b0075__;

  /* ---- Gradientes ----
     Hierarquia deliberada: `action` é o padrão (CTA, botão primário);
     `intel` aparece raro, só onde há inteligência em jogo (badge de score,
     cabeçalho de explicabilidade). Se os dois aparecerem na mesma tela mais
     de uma vez cada, provavelmente há excesso. */
  --gradient-action: __RX_b0076__;
  --gradient-intel: __RX_b0077__;
  --gradient-surface: __RX_b0078__;

  /* ---- Motion ---- */
  --duration-fast: __RX_b0079__;

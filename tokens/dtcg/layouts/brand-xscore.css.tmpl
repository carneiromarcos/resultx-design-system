/* ---- Utility classes ---- */

.text-gradient-intel {
  background: var(--gradient-intel);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Todo número do produto passa por aqui: tabular-nums alinha as colunas e
   evita o "pulo" de dígito que faz uma tabela financeira parecer amadora. */
.numeric {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  letter-spacing: __RX_v1__;
}

/* Foco visível global (WCAG 2.2 SC 2.4.11). O offset garante que o anel não
   seja engolido por fundos adjacentes. */

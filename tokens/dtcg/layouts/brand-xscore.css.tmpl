  --border: __RX_b0092__;
  --border-hover: __RX_b0093__;
  --border-focus: __RX_b0094__;

  --gold: __RX_b0095__;        /* fill de botão (texto --on-gold por cima) */
  --gold-light: __RX_b0096__;
  --gold-ink: __RX_b0097__;    /* texto/ícone dourado — AA sobre branco */
  --on-gold: __RX_b0098__;     /* texto sobre fundo dourado — mesmo nos dois temas */

  --intel: __RX_b0099__;
  --intel-on-dark: __RX_b0100__;   /* sobre claro mantém identidade — 6.86:1 (AA) */


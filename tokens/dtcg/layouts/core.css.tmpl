  /* ── AI orb pigments (components/brand-orb.css) ─────────────────────────
     A orb animada é a assinatura dos agentes de IA (decisão de 05/10/2026).
     Os valores são CÓPIA dos tokens de cada marca — tests/brand-orb.test.js
     reprova se a marca mudar e esta cópia não acompanhar. Iguais nos dois
     temas: a orb é um objeto com luz própria, não uma superfície.
       core  = o foco principal da cor de IA da marca
       glow  = o segundo foco, que dá a cor de reflexo
       shade = o corpo escuro que dá volume                               */
  --ai-electia-core: __RX_t0035__;   /* electia --purple */
  --ai-electia-glow: __RX_t0036__;   /* electia --purple-on-dark */
  --ai-electia-shade: __RX_t0037__;  /* electia --purple-950 */
  --ai-emprega-core: __RX_t0038__;   /* emprega-mais --emp-indigo-dark (IMO) */
  --ai-emprega-glow: __RX_t0039__;   /* emprega-mais --emp-indigo-ink (escuro) */
  --ai-emprega-shade: __RX_t0040__;  /* emprega-mais --emp-navy */
  --ai-xscore-core: __RX_t0041__;    /* xscore --intel (IA = roxo) */
  --ai-xscore-glow: __RX_t0042__;    /* xscore --gold (reflexo, nunca o corpo) */
  --ai-xscore-shade: __RX_t0043__;   /* xscore --bg (grafite) */

  /* ── Spring Curves (physics-based motion) ───────────────────────────── */
  --spring-bounce: __RX_t0044__;
  --spring-smooth: __RX_t0045__;
  --spring-snappy: __RX_t0046__;
  --stagger-delay: __RX_t0047__;

  /* ── Travessia (components/btn-sheen.css) ──────────────────────────────
     Curva de um movimento que precisa ser VISTO de ponta a ponta, como o
     reflexo que atravessa o botão. As molas acima chegam a ~90 % do trajeto
     no primeiro quinto do tempo: num reflexo de 700 ms isso vira um clarão
     de ~150 ms. Esta sai suave e desacelera pouco, então a passada se lê
     inteira. Valor validado no protótipo da #80.                       */
  --ease-sheen: __RX_t0048__;

  /* ── Elevation System (shadow + z-index convention) ────────────────── */
  --elevation-0: __RX_t0049__;
  /* elevation-1 through 4 defined per-theme (different opacity) */

  /* ── DISC gradient end stops ────────────────────────────────────────── */
  --disc-d-light: __RX_t0050__;
  --disc-i-light: __RX_t0051__;
  --disc-s-light: __RX_t0052__;
  --disc-c-light: __RX_t0053__;
}


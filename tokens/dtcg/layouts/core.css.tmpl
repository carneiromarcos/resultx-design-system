  /* Context panel — the resizable column beside the main content.
     --panel-width is the DEFAULT. The live width lives in --split-pane-width,
     set on the .split-pane element itself, so the panel and the space it takes
     from the main column can never drift apart. */
  --panel-width: __RX_t0017__;
  --panel-width-min: __RX_t0018__;
  --panel-width-max: __RX_t0019__;
  --split-handle-width: __RX_t0020__;


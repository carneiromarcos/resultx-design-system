/* Gerado por scripts/build-core.mjs a partir de tokens/tokens.json. Não editar. */
/* ==========================================================================
   ResultX Design System — Unified Tokens
   v2.0.0 | Multi-product: Electia (B2B2C), IMO (B2G), Editais (B2G)

   Usage:
     <link rel="stylesheet" href="tokens/tokens.css">
     <html data-theme="dark">  ← or "light"

   Theme switching (JS):
     document.documentElement.dataset.theme = 'dark' | 'light';

   Auto-detect:
     If no data-theme is set, falls back to prefers-color-scheme.
     Dark is the default when system has no preference.

   Architecture:
     tokens-base.css  → shared across ALL ResultX design systems
     tokens.css       → this file: App DS colors (dark + light) + overrides
   ========================================================================== */

@import url('./base/tokens-base.css');

/* ── Data Layer themes (v2.1.0 — opt-in via data-theme attr) ──────────── */
@import url('./themes/_data-layer-shared.css');

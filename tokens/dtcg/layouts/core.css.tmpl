  --text-2xl: __RX_t0004__;      /* 24px (base: 28px) */
  --text-3xl: __RX_t0005__;    /* 30px (base: 36px) */
  --text-4xl: __RX_t0006__;     /* 36px (base: 44px) */
  --text-display: __RX_t0007__;    /* 48px (App-specific) */


/* Gerado por scripts/build-brand-tokens.mjs. Não editar. */
/* ============================================
   EMPREGA+ — Design Tokens
   Fonte da verdade: a produção (IMO + EditalHub), não o site.
   ADR-0002 decisão 1 — 2026-09-17.

   Identidade de PRODUTO: navy #1c2444 + índigo de ação #4f46e5 sobre
   superfície clara. O ouro (#c49a3c) permanece como pigmento de
   prestígio (site / PdV), não como accent do sistema.

   Prefixos --emp-* são pigmento (ADR-0001: nomes de cor só nesta camada).
   A ponte (ds-bridge.css) traduz para papéis --accent-*.
   ============================================ */

:root {
  /* ---- Navy (base institucional, IMO) ---- */
  --emp-navy: __RX_b0000__;
  --emp-navy-2: __RX_b0001__;
  --emp-table-head: __RX_b0002__;

  /* ---- Índigo (ação de produto — preenchimento) ----
     O FILL do botão de Ação no IMO é --eds-indigo-dark, não o índigo cru.
     Cru #6366f1 + branco = 4,47:1 (abaixo de AA). #4f46e5 + branco = 6,29:1. */
  --emp-indigo: __RX_b0003__;
  --emp-indigo-dark: __RX_b0004__;
  --emp-indigo-hover: __RX_b0005__; /* 92% do dark + preto; branco 7,10:1 */
  --emp-violet: __RX_b0006__;
  --emp-violet-dark: __RX_b0007__;

  /* Tinta do índigo SOBRE superfície. Sólido — a ponte não aceita color-mix.
     :root = tema escuro da ponte (45% índigo + branco). Light sobrescreve. */
  --emp-indigo-ink: __RX_b0008__;

  /* ---- Gold (prestígio — site, não o accent do produto) ---- */
  --emp-gold-light: __RX_b0009__;
  --emp-gold: __RX_b0010__;
  --emp-gold-warm: __RX_b0011__;
  --emp-gold-dark: __RX_b0012__;
  --emp-gold-ink: __RX_b0013__;
  --emp-purple: __RX_b0014__;
  --emp-purple-light: __RX_b0015__;
  --emp-purple-soft: __RX_b0016__;

  /* ---- Superfícies — :root = escuro IMO (o resolver da ponte lê daqui) ---- */
  --emp-bg: __RX_b0017__;
  --emp-surface-1: __RX_b0018__;
  --emp-surface-deep: __RX_b0019__;
  --emp-surface: __RX_b0020__;
  --emp-surface-tonal: __RX_b0021__;
  --emp-border: __RX_b0022__;

  /* ---- Superfícies claras (Gov, site, IMO light) ---- */

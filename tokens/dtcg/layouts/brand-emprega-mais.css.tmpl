@keyframes emp-fade-in-up {
  from { opacity: 0; transform: __RX_v1__; }
  to { opacity: 1; transform: translateY(0); }
}
.emp-reveal {
  animation: emp-fade-in-up var(--emp-duration-reveal) var(--emp-ease-out-expo) forwards;
}
.emp-reveal.d1 { animation-delay: __RX_v2__; opacity: 0; }
.emp-reveal.d2 { animation-delay: __RX_v3__; opacity: 0; }
.emp-reveal.d3 { animation-delay: __RX_v4__; opacity: 0; }

@media (prefers-reduced-motion: reduce) {
  .emp-reveal, .emp-reveal.d1, .emp-reveal.d2, .emp-reveal.d3 {
    animation: none;
    opacity: 1;
    transform: none;
  }
}

.emp-glass {
  background: var(--emp-glass-bg);
  border: __RX_v5__;
  backdrop-filter: __RX_v6__;
}
.emp-glass:hover {
  border-color: var(--emp-glass-border-hover);
}

{
  "name": "resultx-design-system",
  "version": "2.10.0",
  "description": "ResultX Design System — Multi-product (Electia, IMO, Editais) with dark + light themes, spring physics, elevation system, and WCAG AA accessibility.",
  "main": "dist/tokens.min.css",
  "engines": {
    "node": ">=22.22.3"
  },
  "exports": {
    "./tokens": "./dist/tokens.min.css",
    "./tokens/theme": "./dist/tokens.theme.css",
    "./tokens/ts": "./dist/tokens.ts",
    "./tokens/legacy": "./tokens/legacy-aliases.css",
    "./components": "./dist/components.min.css",
    "./components/data-cards": "./components/data-cards.css",
    "./brands/*/bridge": "./brands/*/tokens/ds-bridge.css",
    "./brands/*/tokens": "./brands/*/tokens/tokens.css",
    "./icons": "./dist/icons.min.css",
    "./theme": "./dist/theme-toggle.js",
    "./disclosure": "./dist/disclosure.js",
    "./split-pane": "./dist/split-pane.js",
    "./audio-player": "./dist/audio-player.js",
    "./composer": "./dist/composer.js",
    "./sidebar-overlay": "./dist/sidebar-overlay.js",
    "./header-float": "./dist/header-float.js",
    "./menu-drawer": "./dist/menu-drawer.js",
    "./cta-dock": "./dist/cta-dock.js",
    "./tokens/source": "./tokens/tokens.css",
    "./components/source": "./components/components.css",
    "./package.json": "./package.json",
    "./adapters/css/pilot": "./adapters/css/pilot.css",
    "./adapters/css/pilot/scoped": "./adapters/css/pilot.scoped.css"
  },
  "files": [
    "dist/",
    "tokens/tokens.css",
    "tokens/legacy-aliases.css",
    "tokens/base/tokens-base.css",
    "tokens/themes/",
    "!tokens/themes/preview.html",
    "tokens/tokens.json",
    "brands/*/tokens/ds-bridge.css",
    "brands/*/tokens/tokens.css",
    "components/components.css",
    "components/disclosure.css",
    "components/split-pane.css",
    "components/segmented.css",
    "components/list-item.css",
    "components/message.css",
    "components/audio-player.css",
    "components/composer.css",
    "components/brand-orb.css",
    "components/header-float.css",
    "components/menu-drawer.css",
    "components/btn-sheen.css",
    "components/cta-panel.css",
    "components/cta-dock.css",
    "components/stage-chip.css",
    "components/test-mark.css",
    "components/zone-distribution.css",
    "components/data-cards.css",
    "components/icons.css",
    "docs/",
    "DESIGN-SYSTEM.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "adapters/css/pilot.css",
    "adapters/css/pilot.scoped.css",
    "adapters/css/pilot.scoped.css.sha256",
    "brands/emprega-mais/tokens/pilot-aliases.css",
    "brands/emprega-mais/tokens/pilot-aliases.css.sha256",
    "contracts/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/carneiromarcos/resultx-design-system.git"
  },
  "homepage": "https://carneiromarcos.github.io/resultx-design-system",
  "bugs": {
    "url": "https://github.com/carneiromarcos/resultx-design-system/issues"
  },
  "author": "Marcos Carneiro <marcos@resultx.com.br>",
  "keywords": [
    "design-system",
    "css",
    "tokens",
    "dark-theme",
    "light-theme",
    "wcag",
    "accessibility",
    "glassmorphism",
    "assessment",
    "resultx"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-base.mjs && node scripts/build-data-layer.mjs && node scripts/build-themes.mjs && node scripts/build-core.mjs && node scripts/build-aliases.mjs && node scripts/build-tokens.js && postcss tokens/tokens.css -o dist/tokens.min.css",
    "build:components": "postcss components/components.css -o dist/components.min.css",
    "build:icons": "postcss components/icons.css -o dist/icons.min.css",
    "build:bridges": "node scripts/build-eds-root.mjs --check && node scripts/build-core.mjs && node scripts/build-brand-tokens.mjs && node scripts/build-eds-root.mjs && node scripts/build-brand-bridges.js",
    "build:all": "node scripts/build-eds-root.mjs --check && npm run build:tokens && npm run build:components && npm run build:icons && npm run build:bridges && node scripts/build-pilot-scoped.mjs && node scripts/check-pilot-contrast.cjs",
    "build": "npm run build:all",
    "lint": "stylelint 'components/**/*.css' 'adapters/**/*.css'",
    "lint:fix": "stylelint 'components/**/*.css' --fix",
    "lint:tokens": "stylelint 'tokens/**/*.css'",
    "analyze": "node scripts/bundle-analysis.js",
    "test": "jest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test -u",
    "prepare": "husky",
    "check:eds-root": "node scripts/check-eds-root-copies.js",
    "contracts:cards": "node scripts/contracts/generate-cards.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/visual/"
    ]
  },
  "lint-staged": {
    "components/**/*.css": "stylelint --fix",
    "tokens/**/*.css": "stylelint --fix"
  },
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.64.1",
    "autoprefixer": "^10.6.1",
    "color-name": "1.1.4",
    "cssnano": "^9.8.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "js-yaml": "4.3.2",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "pngjs": "7.0.0",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-value-parser": "4.2.0",
    "style-dictionary": "5.8.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}

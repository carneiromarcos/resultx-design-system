{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ResultX brand tokens (v1.0). Marca guarda-chuva de inovacao — ponte visual entre Emprega+ (gold/confianca) e Electia (purple/tecnologia). Bridge gradient ouro-para-roxo como assinatura unica. Navy compartilhado, dual glass system (Light heranca Emprega+ / Dark heranca Electia). Stack tipografico Sora + Inter + JetBrains Mono (ecossistema). Legacy Poppins+Roboto preservado para migracao do site live.",
  "resultx": {
    "color": {
      "gold": {
        "$description": "Paleta gold — heranca Emprega+ (confianca, institucional)",
        "light": { "$value": "#d4ae54", "$type": "color", "$description": "Hover CTAs de confianca, highlights" },
        "DEFAULT": { "$value": "#c4993b", "$type": "color", "$description": "Primary trust — CTAs institucionais, accents de credibilidade" },
        "dark": { "$value": "#a07b2a", "$type": "color", "$description": "Outline buttons, borders, gradient end" }
      },
      "purple": {
        "$description": "Paleta purple — heranca Electia (tecnologia, inovacao)",
        "light": { "$value": "#a55eea", "$type": "color", "$description": "Hover CTAs de tecnologia, highlights" },
        "DEFAULT": { "$value": "#6f32b1", "$type": "color", "$description": "Primary tech — CTAs de produto, inovacao" },
        "dark": { "$value": "#5a2890", "$type": "color", "$description": "Outline buttons, borders, gradient end" }
      },
      "bg": {
        "$description": "Backgrounds navy — ecossistema compartilhado",
        "base": { "$value": "#1B2A4A", "$type": "color", "$description": "Page background dark — navy canonico do ecossistema" },
        "surface-1": { "$value": "#1c2a4a", "$type": "color", "$description": "Cards e surfaces elevadas em dark" },
        "surface-2": { "$value": "#243661", "$type": "color", "$description": "Cards elevados secundarios" },
        "surface-3": { "$value": "#2d4378", "$type": "color", "$description": "Hover, estados interativos" }
      },
      "surface-light": {
        "$description": "Surfaces claras — tema light (site, propostas, consultoria)",
        "base": { "$value": "#FFFFFF", "$type": "color", "$description": "Background principal tema claro" },
        "subtle": { "$value": "#f5f7f9", "$type": "color", "$description": "Secoes alternadas, rows pares" },
        "muted": { "$value": "#f0f4f8", "$type": "color", "$description": "Cards em superficies claras" },
        "border": { "$value": "#e0e6eb", "$type": "color", "$description": "Bordas em superficies claras" }
      },
      "text": {
        "primary": { "$value": "#FFFFFF", "$type": "color", "$description": "Texto principal em fundo dark" },
        "secondary": { "$value": "#bfd0ec", "$type": "color", "$description": "Corpo em fundo dark" },
        "muted": { "$value": "#5a6b7c", "$type": "color", "$description": "Metadata, placeholders, captions" },
        "inverse": { "$value": "#1B2A4A", "$type": "color", "$description": "Texto em superficies claras" }
      },
      "glass-light": {
        "$description": "Light Glass — heranca Emprega+ (superficies flutuantes em tema claro)",
        "bg": { "$value": "#ffffffb3", "$type": "color", "$description": "White 70% opacity" },
        "border": { "$value": "#1c2a4a14", "$type": "color", "$description": "Navy 8% opacity" }
      },
      "glass-dark": {
        "$description": "Dark Glass — heranca Electia (superficies flutuantes em tema dark)",
        "bg": { "$value": "#1c2a4a99", "$type": "color", "$description": "Navy 60% opacity" },
        "border": { "$value": "#ffffff0f", "$type": "color", "$description": "White 6% opacity" }
      },
      "semantic": {
        "success": { "$value": "#16a34a", "$type": "color", "$description": "Confirmacao, badges positivos" },
        "error": { "$value": "#ef4343", "$type": "color", "$description": "Erro, acoes destructive" },
        "warning": { "$value": "#d97706", "$type": "color", "$description": "Avisos (distinto do gold de marca)" }
      }
    },
    "gradient": {
      "$description": "Gradients — bridge ouro-para-roxo e a assinatura ResultX",
      "bridge": {
        "$value": "linear-gradient(135deg, #c4993b 0%, #6f32b1 100%)",
        "$type": "gradient",
        "$description": "Assinatura de marca — hero, headings, dividers. Ouro→roxo = confianca→inovacao"
      },
      "bridge-subtle": {
        "$value": "linear-gradient(135deg, rgba(196,153,59,0.12) 0%, rgba(111,50,177,0.12) 100%)",
        "$type": "gradient",
        "$description": "Background de cards featured, hover sutil"
      },
      "gold": {
        "$value": "linear-gradient(135deg, #c4993b 0%, #d4ae54 100%)",
        "$type": "gradient",
        "$description": "CTAs de confianca (propostas, consultoria) — heranca Emprega+"
      },
      "purple": {
        "$value": "linear-gradient(135deg, #6f32b1 0%, #a55eea 100%)",
        "$type": "gradient",
        "$description": "CTAs de produto (demos, trials) — heranca Electia"
      }
    },
    "glass": {
      "light": {
        "$description": "Parametros do efeito Light Glass (heranca Emprega+)",
        "blur": { "$value": "12px", "$type": "dimension", "$description": "Blur do backdrop-filter" }
      },
      "dark": {
        "$description": "Parametros do efeito Dark Glass (heranca Electia)",
        "blur": { "$value": "16px", "$type": "dimension", "$description": "Blur do backdrop-filter" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Sora', system-ui, sans-serif", "$type": "fontFamily", "$description": "Display, headings (ecossistema)" },
        "body": { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, UI elements (ecossistema)" },
        "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily", "$description": "Code, valores tecnicos, swatches" },
        "heading-legacy": { "$value": "'Poppins', system-ui, sans-serif", "$type": "fontFamily", "$description": "Headings do site live resultx.app (migracao planejada)" },
        "body-legacy": { "$value": "'Roboto', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body do site live resultx.app (migracao planejada)" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" },
        "extrabold": { "$value": "800", "$type": "fontWeight" }
      },
      "scale": {
        "display": { "$value": "clamp(2.5rem, 6vw, 4.5rem)", "$type": "dimension", "$description": "Hero display — responsivo" },
        "h1": { "$value": "2.5rem", "$type": "dimension", "$description": "40px — headings principais" },
        "h2": { "$value": "2rem", "$type": "dimension", "$description": "32px — section headings" },
        "h3": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — sub-headings, card titles" },
        "eyebrow": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — labels acima de headings" },
        "body-lg": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — lead paragraphs" },
        "body": { "$value": "1rem", "$type": "dimension", "$description": "16px — corpo de texto padrao" },
        "small": { "$value": "0.875rem", "$type": "dimension", "$description": "14px — captions, metadata" },
        "code": { "$value": "0.8125rem", "$type": "dimension", "$description": "13px — blocos de codigo" }
      }
    },
    "spacing": {
      "xs": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
      "sm": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
      "md": { "$value": "1rem", "$type": "dimension", "$description": "16px" },
      "lg": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
      "xl": { "$value": "2rem", "$type": "dimension", "$description": "32px" },
      "2xl": { "$value": "3rem", "$type": "dimension", "$description": "48px" },
      "3xl": { "$value": "5rem", "$type": "dimension", "$description": "80px" },
      "section": { "$value": "clamp(4rem, 3rem + 5vw, 10rem)", "$type": "dimension", "$description": "Espacamento entre secoes — responsivo" }
    },
    "radius": {
      "sm": { "$value": "0.25rem", "$type": "dimension", "$description": "4px — badges, chips" },
      "md": { "$value": "0.5rem", "$type": "dimension", "$description": "8px — inputs, botoes" },
      "lg": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — cards internos" },
      "xl": { "$value": "1rem", "$type": "dimension", "$description": "16px — modais, surfaces grandes" }
    },
    "shadow": {
      "sm": { "$value": "0 4px 20px rgba(27, 42, 74, 0.05)", "$type": "shadow", "$description": "Elevacao sutil — badges, chips" },
      "md": { "$value": "0 4px 12px rgba(27, 42, 74, 0.08)", "$type": "shadow", "$description": "Elevacao padrao — cards, dropdowns" },
      "lg": { "$value": "0 10px 30px rgba(27, 42, 74, 0.12)", "$type": "shadow", "$description": "Elevacao alta — modais, popovers" },
      "glow-gold": { "$value": "0 0 20px rgba(196, 153, 59, 0.20)", "$type": "shadow", "$description": "Glow gold — hover botoes de confianca" },
      "glow-purple": { "$value": "0 0 20px rgba(111, 50, 177, 0.20)", "$type": "shadow", "$description": "Glow purple — hover botoes de tecnologia" },
      "glow-bridge": { "$value": "0 0 20px rgba(196, 153, 59, 0.15), 0 0 20px rgba(111, 50, 177, 0.15)", "$type": "shadow", "$description": "Glow bridge — featured cards, ghost buttons" }
    },
    "motion": {
      "duration": {
        "fast": { "$value": "150ms", "$type": "duration", "$description": "Hover, focus, toggle" },
        "normal": { "$value": "300ms", "$type": "duration", "$description": "Entrada de elementos, transicoes de estado" },
        "slow": { "$value": "500ms", "$type": "duration", "$description": "Page transitions, overlays" }
      },
      "easing": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Easing padrao (spring-out natural)" }
      }
    },
    "layout": {
      "container-max": { "$value": "1200px", "$type": "dimension", "$description": "Largura maxima do container principal" },
      "gutter": { "$value": "1.5rem", "$type": "dimension", "$description": "Gutter padrao do grid" }
    }
  }
}

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ResultX brand tokens (v2.0, 09/10/2026). Marca de consultoria em implementacao de IA e melhoria de processos — ponte visual entre Emprega+ (ouro/confianca) e Electia (roxo/tecnologia). Tema GRAFITE dark-first (mesmo chao do DS, do Electia e do Xscore), tema claro opt-in para propostas e documentos. Regra de acento: ouro = acao e estado ativo; roxo = atmosfera e ponta do gradiente da ponte. Bridge gradient ouro-para-roxo como assinatura. Stack tipografico Sora + Inter + JetBrains Mono. Sem orb (reservada a agentes de IA). Alinhado ao site resultx.app (DS v2.8.1).",
  "resultx": {
    "color": {
      "gold": {
        "$description": "Paleta gold — heranca Emprega+ (confianca, institucional)",
        "light": { "$value": "#d4ae54", "$type": "color", "$description": "Hover CTAs de confianca, highlights" },
        "DEFAULT": { "$value": "#c4993b", "$type": "color", "$description": "ACAO e estado ativo — preenchimento do botao primario, eyebrow, icone, foco, link" },
        "ink": { "$value": "#c4993b", "$type": "color", "$description": "Dourado como TEXTO/icone. No escuro e o proprio ouro (7,33:1 sobre o grafite); no tema claro vira #866425 (5,44:1 sobre branco)" },
        "dark": { "$value": "#a07b2a", "$type": "color", "$description": "Outline buttons, borders, gradient end" }
      },
      "purple": {
        "$description": "Paleta purple — heranca Electia (tecnologia, inovacao)",
        "light": { "$value": "#a55eea", "$type": "color", "$description": "Hover CTAs de tecnologia, highlights" },
        "DEFAULT": { "$value": "#6f32b1", "$type": "color", "$description": "ATMOSFERA e ponta do gradiente da ponte (glow, fundo de secao, moldura de tela). Nao e texto nem preenchimento de botao: 2,55:1 sobre o grafite" },
        "dark": { "$value": "#5a2890", "$type": "color", "$description": "Outline buttons, borders, gradient end" }
      },
      "bg": {
        "$description": "Grafite — chao do ecossistema (tema padrao). Mesma escala do DS no tema escuro",
        "base": { "$value": "#0B0E14", "$type": "color", "$description": "Page background — grafite canonico do ecossistema" },
        "surface-1": { "$value": "#111620", "$type": "color", "$description": "Faixas e secoes tintadas" },
        "surface-2": { "$value": "#161B26", "$type": "color", "$description": "Cards e superficies elevadas" },
        "surface-3": { "$value": "#1C2333", "$type": "color", "$description": "Hover, estados interativos" }
      },
      "surface-light": {
        "$description": "Superficies claras — tema light opt-in (propostas, documentos, consultoria)",
        "base": { "$value": "#FFFFFF", "$type": "color", "$description": "Background principal tema claro" },
        "subtle": { "$value": "#F8FAFB", "$type": "color", "$description": "Secoes alternadas, rows pares" },
        "muted": { "$value": "#F0F3F5", "$type": "color", "$description": "Cards em superficies claras" },
        "border": { "$value": "#D1D9E0", "$type": "color", "$description": "Bordas em superficies claras" }
      },
      "text": {
        "$description": "Texto no tema grafite. No tema claro: #0F1729 / #4B5563 / #5F6672 / inverse #FFFFFF",
        "primary": { "$value": "#E6EDF3", "$type": "color", "$description": "Texto principal (16,3:1 sobre o grafite)" },
        "secondary": { "$value": "#8B949E", "$type": "color", "$description": "Corpo secundario, lead (6,3:1)" },
        "muted": { "$value": "#8A939D", "$type": "color", "$description": "Metadata, placeholders, captions (6,2:1)" },
        "inverse": { "$value": "#0B0E14", "$type": "color", "$description": "Tinta sobre o preenchimento dourado (7,33:1) e sobre superficies claras" }
      },
      "glass-light": {
        "$description": "Light Glass — heranca Emprega+ (superficies flutuantes em tema claro)",
        "bg": { "$value": "#ffffffb3", "$type": "color", "$description": "White 70% opacity" },
        "border": { "$value": "#1c2a4a14", "$type": "color", "$description": "Navy 8% opacity" }
      },
      "glass-dark": {
        "$description": "Dark Glass — padrao do tema grafite (= glass-standard do DS)",
        "bg": { "$value": "#161b2699", "$type": "color", "$description": "Grafite surface-2 a 60%" },
        "border": { "$value": "#ffffff0f", "$type": "color", "$description": "White 6% opacity" }
      },
      "semantic": {
        "$description": "Semanticas no tema grafite (valores do DS). Tema claro: #16a34a / #dc2626 / #d97706 / #2563eb",
        "success": { "$value": "#22c55e", "$type": "color", "$description": "Confirmacao, badges positivos" },
        "error": { "$value": "#ef4444", "$type": "color", "$description": "Erro, acoes destrutivas" },
        "warning": { "$value": "#f59e0b", "$type": "color", "$description": "Avisos (distinto do ouro de marca)" },
        "info": { "$value": "#3b82f6", "$type": "color", "$description": "Informativo" }
      },
      "border": {
        "$description": "Bordas no tema grafite",
        "subtle": { "$value": "#1E2736", "$type": "color", "$description": "Divisores discretos" },
        "default": { "$value": "#2A3444", "$type": "color", "$description": "Borda padrao de card e campo" },
        "strong": { "$value": "#3D4A5C", "$type": "color", "$description": "Borda de enfase" }
      }
    },
    "gradient": {
      "$description": "Gradients — bridge ouro-para-roxo e a assinatura ResultX",
      "bridge": { "$value": "linear-gradient(135deg, #c4993b 0%, #6f32b1 100%)", "$type": "gradient", "$description": "Assinatura de marca — hero, headings, dividers. Ouro→roxo = confianca→inovacao" },
      "bridge-subtle": { "$value": "linear-gradient(135deg, rgba(196,153,59,0.12) 0%, rgba(111,50,177,0.12) 100%)", "$type": "gradient", "$description": "Background de cards featured, hover sutil" },
      "gold": { "$value": "linear-gradient(135deg, #c4993b 0%, #d4ae54 100%)", "$type": "gradient", "$description": "CTAs de confianca (propostas, consultoria) — heranca Emprega+" },
      "purple": { "$value": "linear-gradient(135deg, #6f32b1 0%, #a55eea 100%)", "$type": "gradient", "$description": "CTAs de produto (demos, trials) — heranca Electia" }
    },
    "glass": {
      "light": {
        "$description": "Parametros do efeito Light Glass (heranca Emprega+)",
        "blur": { "$value": "12px", "$type": "dimension", "$description": "Blur do backdrop-filter" }
      },
      "dark": {
        "$description": "Parametros do efeito Dark Glass (heranca Electia)",
        "blur": { "$value": "16px", "$type": "dimension", "$description": "Blur do backdrop-filter" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Sora', system-ui, sans-serif", "$type": "fontFamily", "$description": "Titulos, display, eyebrow — Sora 500/600/700 (carregadas no site)" },
        "body": { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, UI elements (ecossistema)" },
        "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily", "$description": "Rotulos, indices, dado e codigo — JetBrains Mono 500/600" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" }
      },
      "scale": {
        "display": { "$value": "clamp(2.5rem, 6vw, 4.5rem)", "$type": "dimension", "$description": "Hero display — responsivo" },
        "h1": { "$value": "clamp(2.25rem, 1.35rem + 2.9vw, 3.6rem)", "$type": "dimension", "$description": "H1 do hero — escala fluida do site" },
        "h2": { "$value": "clamp(1.75rem, 1.2rem + 1.8vw, 2.5rem)", "$type": "dimension", "$description": "H2 de secao — escala fluida do site" },
        "h3": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — sub-headings, card titles" },
        "eyebrow": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — labels acima de headings" },
        "body-lg": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — lead paragraphs" },
        "body": { "$value": "1rem", "$type": "dimension", "$description": "16px — corpo de texto padrao" },
        "small": { "$value": "0.875rem", "$type": "dimension", "$description": "14px — captions, metadata" },
        "code": { "$value": "0.8125rem", "$type": "dimension", "$description": "13px — blocos de codigo" },
        "tracking-eyebrow": { "$value": "0.16em", "$type": "dimension", "$description": "Espacamento do eyebrow (Sora 600, caixa alta)" }
      }
    },
    "spacing": {
      "xs": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
      "sm": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
      "md": { "$value": "1rem", "$type": "dimension", "$description": "16px" },
      "lg": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
      "xl": { "$value": "2rem", "$type": "dimension", "$description": "32px" },
      "2xl": { "$value": "3rem", "$type": "dimension", "$description": "48px" },
      "3xl": { "$value": "5rem", "$type": "dimension", "$description": "80px" },
      "section": { "$value": "clamp(4rem, 2.8rem + 4.5vw, 7rem)", "$type": "dimension", "$description": "Espacamento entre secoes — escala do site" }
    },
    "radius": {
      "sm": { "$value": "0.25rem", "$type": "dimension", "$description": "4px — badges, chips" },
      "md": { "$value": "0.5rem", "$type": "dimension", "$description": "8px — inputs, botoes" },
      "lg": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — cards internos" },
      "xl": { "$value": "1rem", "$type": "dimension", "$description": "16px — modais, surfaces grandes" }
    },
    "shadow": {
      "$description": "Sombras no tema grafite (valores do DS). Tema claro usa as navy de v1.0: 0 4px 20px / 0 4px 12px / 0 10px 30px sobre rgba(27,42,74)",
      "sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.3)", "$type": "shadow", "$description": "Elevacao sutil" },
      "md": { "$value": "0 4px 12px rgba(0, 0, 0, 0.4)", "$type": "shadow", "$description": "Elevacao padrao — cards, dropdowns" },
      "lg": { "$value": "0 8px 24px rgba(0, 0, 0, 0.5)", "$type": "shadow", "$description": "Elevacao alta — modais, popovers" },
      "glow-gold": { "$value": "0 0 20px rgba(196, 153, 59, 0.20)", "$type": "shadow", "$description": "Glow gold — hover botoes de confianca" },
      "glow-purple": { "$value": "0 0 20px rgba(111, 50, 177, 0.20)", "$type": "shadow", "$description": "Glow purple — hover botoes de tecnologia" },
      "glow-bridge": { "$value": "0 0 20px rgba(196, 153, 59, 0.15), 0 0 20px rgba(111, 50, 177, 0.15)", "$type": "shadow", "$description": "Glow bridge — featured cards, ghost buttons" }
    },
    "motion": {
      "duration": {
        "fast": { "$value": "150ms", "$type": "duration", "$description": "Hover, focus, toggle" },
        "normal": { "$value": "300ms", "$type": "duration", "$description": "Entrada de elementos, transicoes de estado" },
        "slow": { "$value": "500ms", "$type": "duration", "$description": "Page transitions, overlays" }
      },
      "easing": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Easing padrao (spring-out natural)" },
        "smooth": { "$value": "cubic-bezier(0.22, 1, 0.36, 1)", "$type": "cubicBezier", "$description": "= --spring-smooth do DS — revelar e levantar" }
      },
      "reveal": {
        "$description": "Revelar ao rolar e card com profundidade (valores do site)",
        "distance": { "$value": "28px", "$type": "dimension", "$description": "Deslocamento inicial (translate)" },
        "duration": { "$value": "800ms", "$type": "duration", "$description": "Duracao da entrada" },
        "step": { "$value": "90ms", "$type": "duration", "$description": "Atraso por item em lista" }
      },
      "lift": {
        "$description": "Hover com profundidade",
        "duration": { "$value": "280ms", "$type": "duration", "$description": "Transicao de transform/sombra/borda" },
        "distance": { "$value": "-6px", "$type": "dimension", "$description": "Subida do card no hover" }
      }
    },
    "layout": {
      "container-max": { "$value": "1200px", "$type": "dimension", "$description": "Largura maxima do container principal" },
      "gutter": { "$value": "1rem", "$type": "dimension", "$description": "Gutter padrao do site" },
      "header": {
        "$description": "Header flutuante (DS .header-float) na proporcao do site",
        "logo-height": { "$value": "25px", "$type": "dimension", "$description": "Altura da logomarca no header (20px abaixo de 1024px)" },
        "logo-height-compact": { "$value": "20px", "$type": "dimension", "$description": "Altura da logomarca na gaveta" },
        "link-size": { "$value": "1rem", "$type": "dimension", "$description": "Fonte dos links do header" },
        "bar-min": { "$value": "76px", "$type": "dimension", "$description": "Altura minima da barra: 16px de respiro x2 + alvo de 44px" }
      }
    }
  }
}

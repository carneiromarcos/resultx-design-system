{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ResultX brand tokens (v0.2). Canonizado 2026-05-23 extraindo paleta/tipografia reais de resultx.app (theme-color #0d1b2e, brand gradient 5-cor, Poppins+Roboto). Logo Canva: DAHFnUzUpeA.",
  "resultx": {
    "color": {
      "bg": {
        "base": { "$value": "#0d1b2e", "$type": "color", "$description": "Page background — navy escuro (theme-color oficial do site)" },
        "elevated": { "$value": "#192744", "$type": "color", "$description": "Cards, surfaces elevadas" }
      },
      "brand-gradient": {
        "blue": { "$value": "#2040a0", "$type": "color", "$description": "Stop 1 — royal blue (135deg gradient)" },
        "cyan": { "$value": "#00afef", "$type": "color", "$description": "Stop 2 — cyan vibrante" },
        "magenta": { "$value": "#8040a0", "$type": "color", "$description": "Stop 3 — magenta/roxo" },
        "orange": { "$value": "#c08020", "$type": "color", "$description": "Stop 4 — laranja queimado" },
        "gold": { "$value": "#b29442", "$type": "color", "$description": "Stop 5 — ouro/amarelo dourado" }
      },
      "text": {
        "primary": { "$value": "#FFFFFF", "$type": "color", "$description": "Texto principal sobre navy" },
        "inverse": { "$value": "#0d1b2e", "$type": "color", "$description": "Texto sobre fundo claro" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Poppins', system-ui, sans-serif", "$type": "fontFamily", "$description": "Display, headings — Google Fonts (pesos 300-900)" },
        "body": { "$value": "'Roboto', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, UI — Google Fonts (pesos 300-700)" }
      },
      "weight": {
        "light": { "$value": "300", "$type": "fontWeight" },
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" },
        "extrabold": { "$value": "800", "$type": "fontWeight" },
        "black": { "$value": "900", "$type": "fontWeight" }
      }
    },
    "gradient": {
      "brand-hero": {
        "$value": "linear-gradient(135deg, #2040a0, #00afef, #8040a0, #c08020, #b29442)",
        "$type": "string",
        "$description": "Gradient oficial 5-cor — hero, accent X do logo, headlines"
      },
      "navy-deep": {
        "$value": "linear-gradient(135deg, #192744 0%, #0d1b2e 100%)",
        "$type": "string",
        "$description": "Background hero degradê navy"
      }
    }
  }
}

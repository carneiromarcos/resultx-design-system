{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Emprega+ brand tokens. ADR-0002 decisão 1 (2026-09-17): a paleta de PRODUTO vem do IMO em produção (navy #1c2444, ação #4f46e5, light-first). O ouro #c49a3c permanece como pigmento de prestígio (site). Sora + Inter, teto de peso 600.",
  "emprega-mais": {
    "color": {
      "gold": {
        "light": { "$value": "#d4ad55", "$type": "color", "$description": "Prestígio — hover no site, não o accent de produto" },
        "DEFAULT": { "$value": "#c49a3c", "$type": "color", "$description": "Prestígio — secondary da ponte (site / PdV)" },
        "warm": { "$value": "#c49a3c", "$type": "color", "$description": "Alias do DEFAULT" },
        "dark": { "$value": "#a8842f", "$type": "color", "$description": "Gold escuro do site" }
      },
      "indigo": {
        "DEFAULT": { "$value": "#6366f1", "$type": "color", "$description": "Marca crua do tenant default IMO" },
        "dark": { "$value": "#4f46e5", "$type": "color", "$description": "FILL de ação (botão primário) — AA com branco 6,29:1" },
        "hover": { "$value": "#4940d3", "$type": "color", "$description": "Hover do fill; branco 7,10:1" },
        "ink-dark": { "$value": "#b9baf9", "$type": "color", "$description": "Texto índigo sobre superfície escura" },
        "ink-light": { "$value": "#363885", "$type": "color", "$description": "Texto índigo sobre branco (10,19:1)" }
      },
      "navy": {
        "DEFAULT": { "$value": "#1c2444", "$type": "color", "$description": "Navy canônico IMO / site" },
        "2": { "$value": "#34427a", "$type": "color", "$description": "--eds-navy-2" }
      },
      "bg": {
        "base": { "$value": "#171b2b", "$type": "color", "$description": "Superfície escura IMO — :root da ponte (--emp-bg / --eds-surface)" },
        "surface-1": { "$value": "#1e2335", "$type": "color", "$description": "--emp-surface-1 / --eds-surface-tonal" },
        "surface-deep": { "$value": "#0f1320", "$type": "color", "$description": "--emp-surface-deep / body dark IMO" }
      },
      "text": {
        "primary": { "$value": "#e8eaf2", "$type": "color", "$description": "--emp-text / --eds-ink-strong no escuro" },
        "secondary": { "$value": "#a3abc4", "$type": "color", "$description": "--emp-text-secondary / --eds-ink-medium" },
        "muted": { "$value": "#6f7796", "$type": "color", "$description": "--emp-text-muted / --eds-ink-soft" },
        "subtle": { "$value": "#6f7796", "$type": "color", "$description": "Alias de muted no IMO" },
        "inverse": { "$value": "#1e2433", "$type": "color", "$description": "--emp-text-inverse / --eds-ink-strong no claro" }
      },
      "surface-light": {
        "base": { "$value": "#ffffff", "$type": "color", "$description": "--emp-light-bg / --eds-surface claro" },
        "subtle": { "$value": "#fafbfe", "$type": "color", "$description": "--emp-light-subtle / --eds-surface-tonal" },
        "muted": { "$value": "#eef0f7", "$type": "color", "$description": "--emp-light-muted / --eds-surface-tonal-dark" },
        "border": { "$value": "#e9ebf3", "$type": "color", "$description": "--emp-light-border / --eds-border" }
      },
      "glass": {
        "bg": { "$value": "#ffffffb3", "$type": "color", "$description": "Light Glass — white 70%" },
        "border": { "$value": "#1c244414", "$type": "color", "$description": "Navy canônico 8%" },
        "border-hover": { "$value": "#1c244426", "$type": "color", "$description": "Navy canônico 15%" }
      },
      "semantic": {
        "success": { "$value": "#34d399", "$type": "color", "$description": "--eds-success-ink no escuro" },
        "success-dark": { "$value": "#047857", "$type": "color", "$description": "--eds-success-ink no claro" },
        "error": { "$value": "#f87171", "$type": "color", "$description": "--eds-danger-ink no escuro" },
        "error-dark": { "$value": "#b91c1c", "$type": "color", "$description": "--eds-danger-ink no claro" },
        "warning": { "$value": "#fbbf24", "$type": "color", "$description": "--eds-warning-ink no escuro" }
      }
    },
    "radius": {
      "sm": { "$value": "10px", "$type": "dimension", "$description": "--emp-radius-sm / --eds-radius-btn-sm" },
      "md": { "$value": "12px", "$type": "dimension", "$description": "--emp-radius-md / --eds-radius-btn" },
      "lg": { "$value": "16px", "$type": "dimension", "$description": "--emp-radius-lg / --eds-radius-card" },
      "xl": { "$value": "20px", "$type": "dimension", "$description": "--emp-radius-xl / --eds-radius-hero" }
    },
    "motion": {
      "duration": {
        "fast": { "$value": "150ms", "$type": "duration", "$description": "Hover, focus, toggle" },
        "normal": { "$value": "300ms", "$type": "duration", "$description": "Entrada de elementos, transicoes de estado" },
        "slow": { "$value": "500ms", "$type": "duration", "$description": "Page transitions, overlays" },
        "reveal": { "$value": "700ms", "$type": "duration", "$description": "Scroll reveal (fade-in-up)" }
      },
      "easing": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Easing padrao (spring-out natural)" },
        "in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Transicoes suaves bidirecionais" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Sora', ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily", "$description": "Display, headings" },
        "body": { "$value": "'Inter', ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, UI elements" },
        "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily", "$description": "Code, valores tecnicos, swatches" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight", "$description": "Corpo" },
        "medium": { "$value": "500", "$type": "fontWeight", "$description": "Rótulo" },
        "semibold": { "$value": "600", "$type": "fontWeight", "$description": "Título — teto do produto IMO" },
        "bold": { "$value": "600", "$type": "fontWeight", "$description": "Alias: o produto não usa 700" },
        "extrabold": { "$value": "600", "$type": "fontWeight", "$description": "Alias: o produto não usa 800" }
      },
      "scale": {
        "display": { "$value": "clamp(2.5rem, 6vw, 4.5rem)", "$type": "dimension", "$description": "Hero display — responsivo" },
        "h1": { "$value": "2.5rem", "$type": "dimension", "$description": "40px — headings principais" },
        "h2": { "$value": "2rem", "$type": "dimension", "$description": "32px — section headings" },
        "h3": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — sub-headings, card titles" },
        "eyebrow": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — labels acima de headings" },
        "body-lg": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — lead paragraphs" },
        "body": { "$value": "1rem", "$type": "dimension", "$description": "16px — corpo de texto padrao" },
        "small": { "$value": "0.875rem", "$type": "dimension", "$description": "14px — captions, metadata" },
        "code": { "$value": "0.8125rem", "$type": "dimension", "$description": "13px — blocos de codigo" }
      }
    },
    "spacing": {
      "xs": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
      "sm": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
      "md": { "$value": "1rem", "$type": "dimension", "$description": "16px" },
      "lg": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
      "xl": { "$value": "2rem", "$type": "dimension", "$description": "32px" },
      "2xl": { "$value": "3rem", "$type": "dimension", "$description": "48px" },
      "3xl": { "$value": "5rem", "$type": "dimension", "$description": "80px" },
      "section": { "$value": "clamp(4rem, 3rem + 5vw, 10rem)", "$type": "dimension", "$description": "Espacamento entre secoes — responsivo" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 3px rgba(0, 0, 0, 0.45)", "$type": "shadow", "$description": "--emp-shadow-sm no escuro IMO" },
      "md": { "$value": "0 14px 32px -14px rgba(0, 0, 0, 0.7)", "$type": "shadow", "$description": "--emp-shadow-md no escuro IMO" },
      "lg": { "$value": "0 12px 34px -12px rgba(0, 0, 0, 0.6)", "$type": "shadow", "$description": "--emp-shadow-lg no escuro IMO" },
      "glow-brand": { "$value": "0 0 20px rgba(79, 70, 229, 0.20)", "$type": "shadow", "$description": "Glow índigo — ação" },
      "glow-brand-lg": { "$value": "0 0 40px rgba(79, 70, 229, 0.25), 0 0 80px rgba(79, 70, 229, 0.10)", "$type": "shadow", "$description": "Glow índigo amplo" }
    }
  }
}

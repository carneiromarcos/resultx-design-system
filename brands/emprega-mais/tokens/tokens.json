{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Emprega+ brand tokens (v0.3). Marca-mae do ecossistema de empregabilidade (Emprega+, IMO, Editais). Paleta canonizada 2026-05-23 alinhando ao site live empregamais.me (theme-color #1B2A4A, --color-brand-dark #c4993b). Stack tipografico Sora + Inter + JetBrains Mono confirmado.",
  "emprega-mais": {
    "color": {
      "gold": {
        "light": { "$value": "#d4ae54", "$type": "color", "$description": "Hover CTAs, highlights (`--color-brand-light` do site)" },
        "DEFAULT": { "$value": "#c4993b", "$type": "color", "$description": "Primary — CTAs, links, eyebrows, accents (`--color-brand-dark` do site)" },
        "warm": { "$value": "#c49a3c", "$type": "color", "$description": "Variante mais quente, contrastes em fundo claro" },
        "dark": { "$value": "#a07b2a", "$type": "color", "$description": "Outline buttons, borders de destaque (gradient end no tw-gradient-to)" }
      },
      "bg": {
        "base": { "$value": "#1B2A4A", "$type": "color", "$description": "Page background — navy escuro (theme-color oficial do site empregamais.me)" },
        "surface-1": { "$value": "#1c2a4a", "$type": "color", "$description": "Secoes alternadas, cards elevados (proximo do bg, hex usado em glass borders)" },
        "surface-deep": { "$value": "#0f1117", "$type": "color", "$description": "Backgrounds mais profundos (usado pontualmente)" }
      },
      "text": {
        "primary": { "$value": "#FFFFFF", "$type": "color", "$description": "Headings, texto principal em fundo dark" },
        "secondary": { "$value": "#bfd0ec", "$type": "color", "$description": "Texto de corpo em fundo dark (light blue subtle)" },
        "muted": { "$value": "#5a6b7c", "$type": "color", "$description": "Metadata, placeholders, captions (slate)" },
        "subtle": { "$value": "#71717a", "$type": "color", "$description": "Timestamps, labels sutis" },
        "inverse": { "$value": "#1B2A4A", "$type": "color", "$description": "Texto em superficies claras (gov, editais light)" }
      },
      "surface-light": {
        "base": { "$value": "#FFFFFF", "$type": "color", "$description": "Light surfaces (Gov, Editais, light glass)" },
        "subtle": { "$value": "#f5f7f9", "$type": "color", "$description": "Backgrounds alternados light" },
        "muted": { "$value": "#f0f4f8", "$type": "color", "$description": "Cards light (`--color-surface-2` aprox)" },
        "border": { "$value": "#e0e6eb", "$type": "color", "$description": "Bordas em superficies claras (`--color-border` do site)" }
      },
      "glass": {
        "bg": { "$value": "#ffffffb3", "$type": "color", "$description": "Light Glass — white 70% opacity (`--glass-bg` do site)" },
        "border": { "$value": "#1c2a4a14", "$type": "color", "$description": "Light Glass border — navy 8% (`--glass-border` do site)" },
        "border-hover": { "$value": "#1c2a4a26", "$type": "color", "$description": "Light Glass border hover — navy 15% (`--glass-border-hover` do site)" }
      },
      "semantic": {
        "success": { "$value": "#16a34a", "$type": "color", "$description": "Confirmacao, sucesso (green-600 tailwind, usado em badges Gov)" },
        "success-dark": { "$value": "#0d7a30", "$type": "color", "$description": "Gradient end success" },
        "error": { "$value": "#ef4343", "$type": "color", "$description": "Erro, destructive (red-500 tailwind)" },
        "error-dark": { "$value": "#b91c1c", "$type": "color", "$description": "Gradient end error" },
        "warning": { "$value": "#d97706", "$type": "color", "$description": "Aviso (amber-600 tailwind — distinto do gold da marca)" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Sora', system-ui, sans-serif", "$type": "fontFamily", "$description": "Display, headings" },
        "body": { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, UI elements" },
        "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily", "$description": "Code, valores tecnicos, swatches" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" },
        "extrabold": { "$value": "800", "$type": "fontWeight" }
      }
    },
    "radius": {
      "sm": { "$value": "0.25rem", "$type": "dimension", "$description": "4px — badges, chips" },
      "md": { "$value": "0.5rem", "$type": "dimension", "$description": "8px — inputs, botoes" },
      "lg": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — cards" },
      "xl": { "$value": "1rem", "$type": "dimension", "$description": "16px — modais, surfaces grandes" }
    },
    "motion": {
      "duration": {
        "fast": { "$value": "150ms", "$type": "duration", "$description": "Hover, focus, toggle" },
        "normal": { "$value": "300ms", "$type": "duration", "$description": "Entrada de elementos, transicoes de estado" },
        "slow": { "$value": "500ms", "$type": "duration", "$description": "Page transitions, overlays" },
        "reveal": { "$value": "700ms", "$type": "duration", "$description": "Scroll reveal (fade-in-up)" }
      },
      "easing": {
        "out-expo": { "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$type": "cubicBezier", "$description": "Easing padrao (spring-out natural)" },
        "in-out": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$description": "Transicoes suaves bidirecionais" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Sora', system-ui, sans-serif", "$type": "fontFamily", "$description": "Display, headings" },
        "body": { "$value": "'Inter', system-ui, sans-serif", "$type": "fontFamily", "$description": "Body, UI elements" },
        "mono": { "$value": "'JetBrains Mono', monospace", "$type": "fontFamily", "$description": "Code, valores tecnicos, swatches" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" },
        "extrabold": { "$value": "800", "$type": "fontWeight" }
      },
      "scale": {
        "display": { "$value": "clamp(2.5rem, 6vw, 4.5rem)", "$type": "dimension", "$description": "Hero display — responsivo" },
        "h1": { "$value": "2.5rem", "$type": "dimension", "$description": "40px — headings principais" },
        "h2": { "$value": "2rem", "$type": "dimension", "$description": "32px — section headings" },
        "h3": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — sub-headings, card titles" },
        "eyebrow": { "$value": "0.75rem", "$type": "dimension", "$description": "12px — labels acima de headings" },
        "body-lg": { "$value": "1.25rem", "$type": "dimension", "$description": "20px — lead paragraphs" },
        "body": { "$value": "1rem", "$type": "dimension", "$description": "16px — corpo de texto padrao" },
        "small": { "$value": "0.875rem", "$type": "dimension", "$description": "14px — captions, metadata" },
        "code": { "$value": "0.8125rem", "$type": "dimension", "$description": "13px — blocos de codigo" }
      }
    },
    "spacing": {
      "xs": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
      "sm": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
      "md": { "$value": "1rem", "$type": "dimension", "$description": "16px" },
      "lg": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
      "xl": { "$value": "2rem", "$type": "dimension", "$description": "32px" },
      "2xl": { "$value": "3rem", "$type": "dimension", "$description": "48px" },
      "3xl": { "$value": "5rem", "$type": "dimension", "$description": "80px" },
      "section": { "$value": "clamp(4rem, 3rem + 5vw, 10rem)", "$type": "dimension", "$description": "Espacamento entre secoes — responsivo" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 3px rgba(0, 0, 0, 0.05)", "$type": "shadow", "$description": "Elevacao sutil — badges, chips" },
      "md": { "$value": "0 4px 12px rgba(0, 0, 0, 0.08)", "$type": "shadow", "$description": "Elevacao padrao — cards, dropdowns" },
      "lg": { "$value": "0 8px 24px rgba(0, 0, 0, 0.12)", "$type": "shadow", "$description": "Elevacao alta — modais, popovers" },
      "glow-brand": { "$value": "0 0 20px rgba(196, 153, 59, 0.20)", "$type": "shadow", "$description": "Glow gold — hover botoes primarios" },
      "glow-brand-lg": { "$value": "0 0 40px rgba(196, 153, 59, 0.25), 0 0 80px rgba(196, 153, 59, 0.10)", "$type": "shadow", "$description": "Glow gold amplo — hero sections" }
    }
  }
}

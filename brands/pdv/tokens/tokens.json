{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "pdv": {
    "color": {
      "gold": {
        "light": { "$value": "#D4AD55", "$type": "color", "$description": "Hover CTAs, highlights" },
        "DEFAULT": { "$value": "#D4A928", "$type": "color", "$description": "Primary — CTAs, links, eyebrows, accents" },
        "dark": { "$value": "#9C7C1E", "$type": "color", "$description": "Outline buttons, borders de destaque" },
        "muted": { "$value": "#6D5918", "$type": "color", "$description": "Badges premium, detalhes sutis" }
      },
      "bg": {
        "base": { "$value": "#0F1A2E", "$type": "color", "$description": "Page background — navy escuro Emprega+" },
        "surface-1": { "$value": "#132038", "$type": "color", "$description": "Secoes alternadas, cards elevados" },
        "surface-2": { "$value": "#172640", "$type": "color", "$description": "Cards, areas elevadas" },
        "surface-3": { "$value": "#1B2A4A", "$type": "color", "$description": "Hover, estados interativos" },
        "surface-4": { "$value": "#223157", "$type": "color", "$description": "Bordas ativas, inputs" }
      },
      "text": {
        "white": { "$value": "#FFFFFF", "$type": "color", "$description": "Titulos, headings" },
        "gray-100": { "$value": "#E8E8EC", "$type": "color", "$description": "Texto de corpo importante" },
        "gray-200": { "$value": "#C8C8D0", "$type": "color", "$description": "Paragrafos principais" },
        "gray-300": { "$value": "#A0A0AC", "$type": "color", "$description": "Texto secundario" },
        "gray-400": { "$value": "#7E7E8A", "$type": "color", "$description": "Metadados, placeholders" },
        "gray-500": { "$value": "#5A5A66", "$type": "color", "$description": "Timestamps, labels sutis" },
        "gray-600": { "$value": "#2E2E36", "$type": "color", "$description": "Bordas, separadores" }
      },
      "border": {
        "DEFAULT": { "$value": "#26262D", "$type": "color", "$description": "Bordas padrao" },
        "hover": { "$value": "#36363F", "$type": "color", "$description": "Bordas hover" }
      },
      "semantic": {
        "success": { "$value": "#2D8B5C", "$type": "color", "$description": "Confirmacao (unico uso do verde)" },
        "error": { "$value": "#B83A3A", "$type": "color", "$description": "Erro, destructive" },
        "warning": { "$value": "#B8862A", "$type": "color", "$description": "Aviso, atencao" }
      }
    },
    "typography": {
      "family": {
        "heading": { "$value": "'Sora', sans-serif", "$type": "fontFamily", "$description": "Display, headings — o Heroi fala" },
        "body": { "$value": "'Inter', sans-serif", "$type": "fontFamily", "$description": "Body, UI elements — o Sabio explica" }
      },
      "size": {
        "h1-desktop": { "$value": "76px", "$type": "dimension" },
        "h1-mobile": { "$value": "40px", "$type": "dimension" },
        "h2-desktop": { "$value": "44px", "$type": "dimension" },
        "h2-mobile": { "$value": "28px", "$type": "dimension" },
        "h3-desktop": { "$value": "24px", "$type": "dimension" },
        "h3-mobile": { "$value": "20px", "$type": "dimension" },
        "body-large": { "$value": "20px", "$type": "dimension" },
        "body": { "$value": "16px", "$type": "dimension" },
        "small": { "$value": "13px", "$type": "dimension" },
        "eyebrow": { "$value": "12px", "$type": "dimension" },
        "caption": { "$value": "11px", "$type": "dimension" }
      },
      "weight": {
        "regular": { "$value": "400", "$type": "fontWeight" },
        "medium": { "$value": "500", "$type": "fontWeight" },
        "semibold": { "$value": "600", "$type": "fontWeight" },
        "bold": { "$value": "700", "$type": "fontWeight" },
        "extrabold": { "$value": "800", "$type": "fontWeight" }
      },
      "lineHeight": {
        "tight": { "$value": "1.05", "$type": "number", "$description": "H1 display" },
        "heading": { "$value": "1.2", "$type": "number", "$description": "H2, H3" },
        "body": { "$value": "1.7", "$type": "number", "$description": "Corpo — confortavel no dark mode" },
        "relaxed": { "$value": "1.8", "$type": "number", "$description": "Paragrafos longos" }
      },
      "letterSpacing": {
        "tight": { "$value": "-0.03em", "$type": "dimension", "$description": "H1 display" },
        "heading": { "$value": "-0.02em", "$type": "dimension", "$description": "H2, H3, wordmark" },
        "normal": { "$value": "0", "$type": "dimension" },
        "wide": { "$value": "0.05em", "$type": "dimension", "$description": "Labels, badges" },
        "eyebrow": { "$value": "0.15em", "$type": "dimension", "$description": "Eyebrows, section labels" }
      }
    },
    "spacing": {
      "1": { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
      "2": { "$value": "0.5rem", "$type": "dimension", "$description": "8px" },
      "3": { "$value": "0.75rem", "$type": "dimension", "$description": "12px" },
      "4": { "$value": "1rem", "$type": "dimension", "$description": "16px" },
      "5": { "$value": "1.25rem", "$type": "dimension", "$description": "20px" },
      "6": { "$value": "1.5rem", "$type": "dimension", "$description": "24px" },
      "8": { "$value": "2rem", "$type": "dimension", "$description": "32px" },
      "10": { "$value": "2.5rem", "$type": "dimension", "$description": "40px" },
      "12": { "$value": "3rem", "$type": "dimension", "$description": "48px — margem interna minima social media" },
      "16": { "$value": "4rem", "$type": "dimension", "$description": "64px" },
      "20": { "$value": "5rem", "$type": "dimension", "$description": "80px — section spacing" }
    },
    "radius": {
      "sm": { "$value": "4px", "$type": "dimension", "$description": "Badges, tags" },
      "md": { "$value": "8px", "$type": "dimension", "$description": "Buttons, inputs" },
      "lg": { "$value": "12px", "$type": "dimension", "$description": "Cards, containers" },
      "xl": { "$value": "16px", "$type": "dimension", "$description": "Modals, large cards" },
      "2xl": { "$value": "24px", "$type": "dimension", "$description": "Pill buttons" },
      "full": { "$value": "9999px", "$type": "dimension", "$description": "Avatares, dots" }
    },
    "shadow": {
      "sm": { "$value": "0 1px 2px rgba(0,0,0,0.4)", "$type": "shadow" },
      "md": { "$value": "0 4px 12px rgba(0,0,0,0.5)", "$type": "shadow" },
      "lg": { "$value": "0 8px 24px rgba(0,0,0,0.6)", "$type": "shadow" },
      "glow-brand": { "$value": "0 0 20px rgba(212,169,40,0.25)", "$type": "shadow", "$description": "Glow ouro sutil — hero CTA" },
      "glow-brand-lg": { "$value": "0 0 40px rgba(212,169,40,0.35), 0 0 80px rgba(212,169,40,0.15)", "$type": "shadow", "$description": "Glow ouro forte — max 1/pagina" }
    },
    "glass": {
      "subtle": {
        "bg": { "$value": "rgba(15,26,46,0.4)", "$type": "color" },
        "blur": { "$value": "12px", "$type": "dimension" },
        "border": { "$value": "rgba(255,255,255,0.04)", "$type": "color" }
      },
      "standard": {
        "bg": { "$value": "rgba(15,26,46,0.6)", "$type": "color" },
        "blur": { "$value": "16px", "$type": "dimension" },
        "border": { "$value": "rgba(255,255,255,0.06)", "$type": "color" }
      },
      "strong": {
        "bg": { "$value": "rgba(15,26,46,0.85)", "$type": "color" },
        "blur": { "$value": "24px", "$type": "dimension" },
        "border": { "$value": "rgba(255,255,255,0.08)", "$type": "color" }
      }
    },
    "gradient": {
      "brand": { "$value": "linear-gradient(135deg, #D4A928 0%, #D4AD55 100%)", "$type": "gradient", "$description": "CTAs, barras de destaque, hero" },
      "brand-subtle": { "$value": "linear-gradient(135deg, rgba(212,169,40,0.12) 0%, rgba(109,89,24,0.12) 100%)", "$type": "gradient", "$description": "Fundos de cards, hover sutil" },
      "gold-line": { "$value": "linear-gradient(90deg, transparent 0%, #D4A928 30%, transparent 100%)", "$type": "gradient", "$description": "Separadores, topo de cards featured" }
    },
    "transition": {
      "fast": { "$value": "150ms ease", "$type": "duration" },
      "base": { "$value": "200ms ease", "$type": "duration" },
      "slow": { "$value": "300ms ease-out", "$type": "duration" },
      "spring": { "$value": "500ms cubic-bezier(0.34, 1.56, 0.64, 1)", "$type": "duration" },
      "reveal": { "$value": "700ms cubic-bezier(0.16, 1, 0.3, 1)", "$type": "duration", "$description": "Scroll reveal — fade up" }
    },
    "breakpoint": {
      "sm": { "$value": "640px", "$type": "dimension" },
      "md": { "$value": "768px", "$type": "dimension" },
      "lg": { "$value": "1024px", "$type": "dimension" },
      "xl": { "$value": "1280px", "$type": "dimension" }
    }
  }
}